# IndiaMART Credentials
INDIAMART_EMAIL=your_email@example.com
INDIAMART_PASSWORD=your_password

# Scraper Configuration
HEADLESS=true
SCREENSHOT_ON_ERROR=true
DEBUG_MODE=false

# Filters
COUNTRY_FILTER=India
EMAIL_REQUIRED=true
PHONE_REQUIRED=true

# Delays (in milliseconds) to avoid detection
BASE_DELAY=1000
RANDOM_DELAY=2000

# Logging
LOG_LEVEL=info

# Proxy (optional)
USE_PROXY=false
PROXY_URL=
